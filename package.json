{
  "name": "oculix-vscode",
  "displayName": "OculiX for VS Code",
  "publisher": "migueldomingues",
  "icon": "resources/oculix.png",
  "description": "Screenshot capture, pattern references, and image previews for OculiX scripts",
  "version": "0.10.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/MiguelDomingues/oculix-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/MiguelDomingues/oculix-vscode/issues"
  },
  "homepage": "https://github.com/MiguelDomingues/oculix-vscode#readme",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:python",
    "onWebviewPanel:oculixPreview"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "oculix.captureRegion",
        "title": "OculiX: Capture Screen Region",
        "icon": "$(device-camera)"
      },
      {
        "command": "oculix.openPreview",
        "title": "OculiX: Open Preview to the Side",
        "icon": "resources/oculix.png"
      },
      {
        "command": "oculix.runScript",
        "title": "OculiX: Run Script",
        "icon": "$(play)"
      },
      {
        "command": "oculix.runCurrentLine",
        "title": "OculiX: Run Current Line",
        "icon": "$(debug-step-over)"
      },
      {
        "command": "oculix.runSelection",
        "title": "OculiX: Run Selection",
        "icon": "$(selection)"
      },
      {
        "command": "oculix.stopRun",
        "title": "OculiX: Stop Run",
        "icon": "$(debug-stop)"
      }
    ],
    "keybindings": [
      {
        "command": "oculix.captureRegion",
        "key": "ctrl+shift+s",
        "mac": "cmd+shift+s",
        "when": "editorTextFocus && editorLangId == python"
      },
      {
        "command": "oculix.openPreview",
        "key": "ctrl+shift+v",
        "mac": "cmd+shift+v",
        "when": "editorTextFocus && editorLangId == python"
      },
      {
        "command": "oculix.runScript",
        "key": "ctrl+shift+r",
        "mac": "cmd+shift+r",
        "when": "editorTextFocus && editorLangId == python"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "oculix.captureRegion",
          "when": "editorLangId == python",
          "group": "oculix"
        },
        {
          "command": "oculix.openPreview",
          "when": "editorLangId == python",
          "group": "oculix"
        },
        {
          "command": "oculix.runScript",
          "when": "editorLangId == python",
          "group": "oculix@10"
        },
        {
          "command": "oculix.runCurrentLine",
          "when": "editorLangId == python",
          "group": "oculix@11"
        },
        {
          "command": "oculix.runSelection",
          "when": "editorLangId == python && editorHasSelection",
          "group": "oculix@12"
        },
        {
          "command": "oculix.stopRun",
          "when": "editorLangId == python && oculix.isRunning",
          "group": "oculix@13"
        }
      ],
      "editor/title": [
        {
          "command": "oculix.openPreview",
          "when": "editorLangId == python",
          "group": "navigation"
        },
        {
          "command": "oculix.runScript",
          "when": "editorLangId == python",
          "group": "navigation@10"
        }
      ]
    },
    "configuration": {
      "title": "OculiX for VS Code",
      "properties": {
        "oculix.imageFolder": {
          "type": "string",
          "default": "",
          "description": "Folder to save captured images (relative to workspace root). Leave empty to use same folder as current script."
        },
        "oculix.captureHelper": {
          "type": "string",
          "enum": [
            "python",
            "auto"
          ],
          "default": "auto",
          "description": "Which helper to use for screen capture."
        },
        "oculix.captureMinimizeDelayMs": {
          "type": "number",
          "default": 125,
          "minimum": 0,
          "maximum": 2000,
          "description": "Delay in milliseconds after minimizing VS Code before showing the capture overlay. Lower is faster; higher can avoid capturing minimize animation artifacts."
        },
        "oculix.captureDelaySeconds": {
          "type": "number",
          "default": 3,
          "minimum": 0,
          "maximum": 30,
          "description": "Countdown duration in seconds before freezing the screen for region selection."
        },
        "oculix.previewImageHeight": {
          "type": "number",
          "default": 200,
          "minimum": 24,
          "maximum": 1200,
          "description": "Maximum height (in pixels) of each Pattern(\"...\") thumbnail rendered in the OculiX Preview panel. Aspect ratio is preserved."
        },
        "oculix.overlayDimPercent": {
          "type": "number",
          "default": 30,
          "minimum": 0,
          "maximum": 100,
          "description": "Overlay dim amount as a percentage (0-100) used during capture and test modes. Higher values dim more."
        },
        "oculix.overlayDimColor": {
          "type": "string",
          "default": "#000000",
          "format": "color-hex",
          "description": "Overlay tint color used during capture and test modes."
        },
        "oculix.cleanupUnreferencedImagesOnSave": {
          "type": "boolean",
          "default": true,
          "description": "On save of a Python file, move any .png in the image folder that is not referenced by name in any .py file in the workspace to the trash. References inside comments count."
        },
        "oculix.autoPairSikuliRenames": {
          "type": "boolean",
          "default": false,
          "description": "Automatically keep .sikuli folder names and their paired .py script names in sync during rename operations."
        },
        "oculix.runtimeMode": {
          "type": "string",
          "enum": [
            "auto",
            "path"
          ],
          "default": "auto",
          "description": "How to resolve OculiX runtime: auto manages runtime downloads, path uses oculix.runtimeJarPath."
        },
        "oculix.runtimeJarPath": {
          "type": "string",
          "default": "",
          "description": "Path to an OculiX IDE runtime JAR (used when oculix.runtimeMode is path)."
        },
        "oculix.runtimeVersion": {
          "type": "string",
          "default": "latest",
          "description": "Runtime version used in auto mode. Use latest or an explicit version like 3.0.4."
        },
        "oculix.runtimeUpdateCheckOnStartup": {
          "type": "boolean",
          "default": true,
          "description": "When using auto + latest runtime mode, checks for new runtime versions in the background when extension activates."
        },
        "oculix.runtimeUpdateCheckIntervalHours": {
          "type": "number",
          "default": 24,
          "minimum": 1,
          "maximum": 720,
          "description": "Minimum interval, in hours, between background runtime update checks in auto + latest mode."
        },
        "oculix.extraJarPaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Paths to JAR files to add to Jython's sys.path before running a script. Enables load('file.jar') to resolve JARs from these locations."
        }
      }
    },
    "grammars": [
      {
        "path": "./syntaxes/oculix.tmLanguage.json",
        "scopeName": "source.oculix-injected",
        "injectTo": [
          "source.python"
        ],
        "embeddedLanguages": {}
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "bump": "node scripts/bump-version.js"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "@types/vscode": "^1.85.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.45"
  }
}
